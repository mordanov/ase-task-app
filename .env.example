# Environment: local | dev | prod
APP_ENV=local

# PostgreSQL (used by Keycloak only — backend uses SQLite locally)
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=

# Google OAuth (Identity Provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Identity Provider)
AZURE_APPLICATION_ID=
AZURE_CLIENT_SECRET=

# GitHub OAuth (Identity Provider)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Keycloak
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_admin_password
# ^ these map to KEYCLOAK_ADMIN/PASSWORD inside docker-compose
KC_HEALTH_ENABLED=true
KC_HTTP_PORT=8080

# Backend — Keycloak connection
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=app-realm
KEYCLOAK_CLIENT_ID=backend-client
KEYCLOAK_CLIENT_SECRET=
CORS_ORIGINS=http://localhost:3001

# Backend — Database (local=SQLite auto; dev/prod set DB_HOST etc.)
# DB_HOST=aurora-cluster-endpoint
# DB_PORT=5432
# DB_USER=keycloakapp
# DB_PASSWORD=
# DB_NAME=keycloakapp

# Backend — DynamoDB
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
DYNAMODB_SESSIONS_TABLE=keycloak-app-local-sessions

# Frontend
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=app-realm
VITE_KEYCLOAK_CLIENT_ID=frontend-client
VITE_API_URL=http://localhost:3030
